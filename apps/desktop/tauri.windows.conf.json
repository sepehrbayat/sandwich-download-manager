{
  "$schema": "https://schema.tauri.app/config/2",
  "plugins": {
    "updater": {
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/256x256.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true }
    },
    "resources": [
      "binaries/aria2c.exe",
      "binaries/aria2-COPYING.txt",
      "binaries/aria2-LICENSE.OpenSSL.txt",
      "binaries/sandwich-browser-host.exe"
    ]
  }
}
