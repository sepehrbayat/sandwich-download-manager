{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sandwich Download Manager",
  "version": "0.6.1",
  "identifier": "dev.sandwich.download-manager",
  "build": {
    "frontendDist": "../../src",
    "beforeBuildCommand": "cargo build --release -p sandwich-browser-host"
  },
  "app": {
    "windows": [
      {
        "title": "Sandwich Download Manager",
        "width": 960,
        "height": 720,
        "minWidth": 680,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCN0E5QjczRkQ5ODZDRDkKUldUWmJKajljNXQ2SytaQVVsR3A1eUMzc2ZaQzVwQWpFeFRSbkc4c0ZNN0FXM0ZqM3dkOC9PeFgK",
      "endpoints": [
        "https://github.com/sepehrbayat/sandwich-download-manager/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns"
    ],
    "publisher": "Sandwich",
    "copyright": "GPL-3.0-only",
    "category": "Utility",
    "shortDescription": "Free, open-source download manager",
    "longDescription": "Sandwich is a free and open-source download manager for Windows, macOS, and Linux. It splits each transfer into segments for speed, resumes reliably after interruptions, and keeps a clean, readable queue."
  }
}
