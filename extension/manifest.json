{
  "manifest_version": 3,
  "name": "Sandwich Download Manager",
  "version": "0.6.1",
  "description": "Send browser downloads and permitted direct media to Sandwich Download Manager.",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "cookies",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["policy.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sandwich",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  }
}
