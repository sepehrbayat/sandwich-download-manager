{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Workstream Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "workstreamId",
    "ownerRole",
    "producerActorId",
    "status",
    "implementationRevision",
    "changedComponents",
    "commands",
    "evidence",
    "knownRisks",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "type": "string"
    },
    "planId": {
      "type": "string",
      "pattern": "^ENGPLAN-[A-Za-z0-9._-]+$"
    },
    "workstreamId": {
      "type": "string",
      "pattern": "^WS-[0-9]{2}$"
    },
    "ownerRole": {
      "type": "string",
      "pattern": "^ENG-[0-9]{2}$"
    },
    "producerActorId": {
      "type": "string",
      "minLength": 2
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "failed"
      ],
      "type": "string"
    },
    "verificationDisposition": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_applicable"
      ],
      "type": "string"
    },
    "implementationRevision": {
      "type": "string",
      "minLength": 7
    },
    "changedComponents": {
      "$ref": "#/$defs/strings"
    },
    "commands": {
      "$ref": "#/$defs/strings"
    },
    "evidence": {
      "$ref": "#/$defs/strings"
    },
    "knownRisks": {
      "$ref": "#/$defs/strings"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
